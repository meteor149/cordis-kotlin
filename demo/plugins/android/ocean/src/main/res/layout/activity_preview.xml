<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/badge_background"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:text="CORDIS PLUGIN · OCEAN"
        android:textColor="#7ED9FF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="54dp"
        android:text="◉"
        android:textColor="#53C8FF"
        android:textSize="58sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Deep Ocean"
        android:textColor="#F2FAFF"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Dive into a quiet blue frequency"
        android:textColor="#9ABED5"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="46dp"
        android:background="@drawable/card_background"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="An independent resource space"
            android:textColor="#F2FAFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ocean.apk keeps its own resource table and ClassLoader; the host only provides the window and lifecycle."
            android:textColor="#9ABED5"
            android:textSize="14sp" />
    </LinearLayout>

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/close"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/close_background"
        android:gravity="center"
        android:text="Back to the surface"
        android:textColor="#031522"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
